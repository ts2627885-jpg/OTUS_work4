# ============================================
# Application Environment
# ============================================
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=azs_pult
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000

# ============================================
# Security & JWT
# ============================================
# IMPORTANT: Change these in production!
JWT_SECRET=your-super-secret-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=24h

# ============================================
# Redis Cache
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================
# CORS Configuration
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug

# ============================================
# Email (for future use)
# ============================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ============================================
# AWS S3 (for future file uploads)
# ============================================
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ============================================
# API Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Feature Flags
# ============================================
FEATURE_RECOMMENDATIONS=true
FEATURE_IMPORT=true
FEATURE_AUDIT_LOGS=true
