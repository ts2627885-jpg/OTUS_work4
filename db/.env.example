# Скопируйте в db/.env и задайте свои пароли. Файл .env не попадает в git.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_superuser_password
POSTGRES_DB=azs_pult

# Роль приложения (без BYPASSRLS, для backend)
APP_DB_USER=azs_app
APP_DB_PASSWORD=CHANGE_ME_app_password

# Адрес публикации порта на хосте. 127.0.0.1 — только локально на сервере.
DB_BIND=127.0.0.1
DB_PORT=5432
