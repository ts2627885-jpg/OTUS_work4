VITE_API_URL=http://localhost:3001/api
# Счётчик Яндекс.Метрики (номер из интерфейса Метрики). Пусто — аналитика отключена
VITE_YANDEX_METRIKA_ID=
# Идентификатор потока Google Analytics 4 (вида G-XXXXXXXXXX). Пусто — GA отключена
VITE_GOOGLE_ANALYTICS_ID=
# true — печатать события аналитики в консоль браузера (для проверки)
VITE_ANALYTICS_DEBUG=false
