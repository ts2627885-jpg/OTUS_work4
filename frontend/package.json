{
  "name": "azs-pult-frontend",
  "version": "2.1.0",
  "description": "АЗС-Пульт Frontend - Vue 3 with Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "test": "vitest",
    "format": "prettier --write \"src/**/*.{js,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\""
  },
  "dependencies": {
    "axios": "^1.6.5",
    "chart.js": "^4.4.1",
    "element-plus": "^2.4.4",
    "pinia": "^2.1.6",
    "vue": "^3.3.10",
    "vue-chartjs": "^5.2.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1"
  }
}
